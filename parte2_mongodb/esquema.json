        },
        "nome": {
          "bsonType": "string",
          "maxLength": 40
        },
        "pre_req": {
          "bsonType": ["string", "null"],
          "maxLength": 8
        },
        "creditos": {
          "bsonType": ["int", "null"],
          "minimum": 1,
          "maximum": 12,
          "exclusiveMaximum": true
        },
        "depto_responsavel": {
          "bsonType": ["string", "null"],
          "maxLength": 5
        }
      }
    }
  },
  "semestres": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": ["ano", "semestre"],
      "properties": {
        "ano": {
          "bsonType": "int"
        },
        "semestre": {
          "bsonType": "int"
        },
        "data_inicio": {
          "bsonType": ["date", "null"]
        },
        "data_fom": {
          "bsonType": ["date", "null"]
        }
      }
    }
  },
  "salas": {
    "$jsonSchema": {
      "bsonType": "object",
